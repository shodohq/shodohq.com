{
  "extends": "./tsconfig.json",
  "include": ["vite.config.ts", "vite-plugins/**/*", "app/lib/content-schema.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // Viteの設定ファイルの読み込みは、拡張子のないimportを警告するため
    "allowImportingTsExtensions": true
  }
}
