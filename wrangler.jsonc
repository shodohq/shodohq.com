// Workersの設定（docs/spec.md §15.3）
// 静的アセットの設定（assets）は、CloudflareのViteプラグインがビルドのときに作る。ここには書かない
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shodo-site",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-25",
  "vars": {
    "SITE_ORIGIN": "https://shodohq.com",
    // 決まったら入れる（docs/open-items.md #5）。空ならGAを出さない
    "GA_MEASUREMENT_ID": "",
    // Turnstileを使う場合だけ（docs/open-items.md #4）
    "TURNSTILE_SITE_KEY": ""
  },
  // フォームの連続送信の制限。IPアドレスごとに60秒に5回まで（docs/spec.md §6.5）
  "ratelimits": [
    { "name": "INQUIRY_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // 呼び出しごとの自動のログはIPアドレスなどが残るので切る
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
  "upload_source_maps": true,
  "preview_urls": true
  // 本番のドメイン。DNSの準備が決まったら足す（docs/open-items.md #1、docs/spec.md §15.5）
  // "routes": [{ "pattern": "shodohq.com", "custom_domain": true }]
}
